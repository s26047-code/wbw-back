# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요. (.env 는 Git에 올리지 마세요)

# --- 데이터베이스 ---
DB_URL=jdbc:mysql://localhost:3306/wbw?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=wbw
DB_PASSWORD=

# --- 구글 로그인 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 프론트엔드 연동 ---
# 로그인 후 돌아갈 주소 & 공유 링크 기준 주소
FRONTEND_URL=http://localhost:5173
# 쉼표로 여러 개 지정 가능
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- 세션 쿠키 ---
# HTTPS 배포 시 true
SESSION_COOKIE_SECURE=false
# 프론트와 API가 같은 사이트면 lax, 서로 다른 사이트(도메인)면 none (+ SESSION_COOKIE_SECURE=true 필수)
SESSION_COOKIE_SAME_SITE=lax

# --- 기타 ---
# Swagger UI(/swagger-ui.html) 노출 여부. 실서비스 공개 후에는 false 권장
SWAGGER_ENABLED=true
PORT=8080
PDF_FONT_DIR=./fonts

# --- docker-compose 전용 (MySQL 컨테이너 초기 비밀번호) ---
MYSQL_ROOT_PASSWORD=
